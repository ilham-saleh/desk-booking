// Prisma schema for the desk booking system — multi-tenant SaaS (CLAUDE.md v2.2).
// 14 core entities. Every tenant-owned model carries an explicit organizationId,
// enforced centrally by the tenant-scoping client (src/server/db/tenant-scope.ts) —
// see CLAUDE.md architectural rule 1. The no-double-booking (rule 2) and
// one-active-booking-per-user (rule 4) constraints are GiST exclusion constraints
// added by a hand-written migration (prisma/migrations/*_booking_overlap_constraints)
// — Prisma has no schema syntax for EXCLUDE constraints, so they're invisible here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLATFORM_ADMIN
  ORG_SUPER_ADMIN
  SITE_ADMIN
  BOOKING_MANAGER
  STANDARD_USER
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

/// What a Permission row grants at its site. A row is only meaningful for the
/// role it belongs to (FACILITY_ADMIN rows for SITE_ADMIN users, BOOK_FOR_OTHERS
/// rows for BOOKING_MANAGER users) — changing a user's role removes rows of the
/// type the new role can't use, so no hidden access is left behind.
enum PermissionType {
  /// Manage the site: floors, editor, desks, restrictions, relevant users.
  FACILITY_ADMIN
  /// Book desks on behalf of other employees at the site (Booking Manager).
  BOOK_FOR_OTHERS
}

enum FloorPlanVersionStatus {
  DRAFT
  LIVE
  ARCHIVED
}

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  CANCELLED
  AUTO_CANCELLED
  COMPLETED
}

enum DeskState {
  AVAILABLE
  BOOKED
  SCHEDULED
  INACTIVE
}

enum RestrictionFieldType {
  DEPARTMENT
  EMAIL
  USER
}

enum RestrictionOperator {
  IS
  IS_NOT
  IS_ANY_OF
  IS_NOT_ANY_OF
  IS_EMPTY
  IS_NOT_EMPTY
}

/// How a rule joins onto the rule before it. The first rule's connector is
/// ignored. AND binds tighter than OR, so rules evaluate as OR-of-AND-groups.
enum RuleConnector {
  AND
  OR
}

/// "Bookings restricted to" — who a desk restriction assignment admits.
enum DeskRestrictionMode {
  ANYONE
  ASSIGNED_OCCUPANTS
  DEPARTMENT
  CUSTOM
}

enum DeskAssignmentMode {
  BOOKABLE
  ASSIGNED
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

/// The tenant. Every other model belongs to exactly one Organization, except
/// User — nullable there, and null only for PLATFORM_ADMIN (who belongs to no org).
model Organization {
  id     String    @id @default(cuid())
  name   String
  slug   String    @unique
  status OrgStatus @default(ACTIVE)

  /// Microsoft Entra ID is the only SSO. A sign-in is accepted for this org
  /// only when the token's `tid` equals ssoEntraTenantId (and, when set, its
  /// `iss` equals ssoEntraIssuer).
  ssoEntraTenantId String?
  ssoEntraIssuer   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                  User[]
  permissions            Permission[]
  sites                  Site[]
  floors                 Floor[]
  floorPlanVersions      FloorPlanVersion[]
  desks                  Desk[]
  rooms                  Room[]
  utilities              Utility[]
  bookings               Booking[]
  deskWatches            DeskWatch[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  departments            Department[]
  bookingRestrictions    BookingRestriction[]
  availabilityShifts     AvailabilityShift[]
  deskRestrictionAssignments DeskRestrictionAssignment[]
  deskRestrictionOccupants DeskRestrictionOccupant[]
  deskAttributes         DeskAttribute[]
  siteOperatingHours     SiteOperatingHours[]
  neighbourhoods         Neighbourhood[]

  @@map("organizations")
}

/// Created on the employee's first Microsoft Entra sign-in and refreshed on each
/// later one (src/server/auth/resolve-org.ts). Identity/profile fields (email,
/// names, title, department, location, employeeId, phone) are Entra-owned.
/// role, isActive, timezone and the Permission rows are application-owned and
/// must never be overwritten by a sign-in.
model User {
  id             String   @id @default(cuid())
  organizationId String? // null only for PLATFORM_ADMIN
  email          String
  /// Entra `oid` claim — the stable match key, preferred over email.
  entraObjectId  String?
  /// Display name from Entra (falls back to firstName + lastName).
  name           String
  firstName      String?
  lastName       String?
  /// Entra `employeeId` attribute, when the tenant sets it.
  employeeId     String?
  title          String?
  department     String?
  /// Entra office location label. Not a site permission — see Permission.
  location       String?
  phone          String?
  timezone       String?
  role           Role
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])

  permissions              Permission[]
  bookingsAsUser           Booking[]          @relation("BookingUser")
  bookingsBookedBy         Booking[]          @relation("BookingBookedBy")
  bookingsCancelledBy      Booking[]          @relation("BookingCancelledBy")
  deskWatches              DeskWatch[]
  notifications            Notification[]
  auditLogs                AuditLog[]
  createdFloorPlanVersions FloorPlanVersion[]
  assignedDesks            Desk[]             @relation("AssignedOccupant")
  deskRestrictionOccupants DeskRestrictionOccupant[]
  neighbourhoodMemberships NeighbourhoodMember[]

  @@unique([organizationId, email])
  @@unique([organizationId, entraObjectId])
  @@unique([organizationId, employeeId])
  @@index([organizationId, role])
  @@index([organizationId, isActive])
  @@map("users")
}

/// A user's explicit, application-owned site scope. One row per user+site; the
/// `type` says what the row grants there (see PermissionType). System Admins
/// hold no rows — their role grants every site.
model Permission {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  siteId         String
  type           PermissionType
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id])

  @@unique([userId, siteId])
  @@map("permissions")
}

model Site {
  id             String @id @default(cuid())
  organizationId String
  name           String
  address        String?
  city           String?
  country        String?
  postalCode     String?
  description    String?
  timeZone       String

  /// Deprecated: use SiteOperatingHours instead. Kept for backwards compatibility.
  operatingHoursStart Int @default(0)
  operatingHoursEnd   Int @default(1440)

  photoUrl                    String?
  unitSystem                  UnitSystem @default(METRIC)
  allowEmployeeSeeBookings    Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id])
  floors               Floor[]
  permissions          Permission[]
  operatingHours       SiteOperatingHours[]

  @@map("sites")
}

model Floor {
  id             String @id @default(cuid())
  organizationId String
  siteId         String
  name           String
  sortOrder      Int    @default(0)

  livePlanVersionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id])
  site            Site              @relation(fields: [siteId], references: [id])
  livePlanVersion FloorPlanVersion? @relation("FloorLiveVersion", fields: [livePlanVersionId], references: [id])
  planVersions    FloorPlanVersion[] @relation("FloorVersions")
  desks           Desk[]
  rooms           Room[]
  utilities       Utility[]
  neighbourhoods  Neighbourhood[]

  @@map("floors")
}

/// Draft/live/archived history for a floor's map background — enables the
/// draft-vs-live editor workflow (CLAUDE.md rule 8) and rollback.
model FloorPlanVersion {
  id               String                 @id @default(cuid())
  organizationId   String
  floorId          String
  status           FloorPlanVersionStatus @default(DRAFT)
  sourceFileKey    String
  renderedImageKey String?
  /// Pixel dimensions of renderedImageKey — the floor-map canvas needs these to
  /// scale the background image and position desks/rooms/utilities correctly.
  imageWidth       Int?
  imageHeight      Int?
  createdById      String
  publishedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  floor        Floor        @relation("FloorVersions", fields: [floorId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])
  liveForFloor Floor?       @relation("FloorLiveVersion")

  @@map("floor_plan_versions")
}

model Desk {
  id                String              @id @default(cuid())
  organizationId    String
  floorId           String
  number            String
  name              String?
  x                 Float
  y                 Float
  capacity          Int                 @default(1)
  isActive          Boolean             @default(true)
  requiresCheckIn   Boolean             @default(false)
  spaceType         String?
  description       String?
  assignmentMode    DeskAssignmentMode  @default(BOOKABLE)
  assignedOccupantId String?
  /// Set when an admin removes a desk that still has booking history — the
  /// desk disappears from every map but its bookings stay auditable.
  archivedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id])
  floor              Floor               @relation(fields: [floorId], references: [id])
  assignedOccupant   User?               @relation("AssignedOccupant", fields: [assignedOccupantId], references: [id])
  bookings           Booking[]
  deskWatches        DeskWatch[]
  restrictionAssignments DeskRestrictionAssignment[]
  attributes         DeskAttribute[]
  neighbourhoods     NeighbourhoodDesk[]

  @@unique([floorId, number])
  @@index([floorId, archivedAt])
  @@map("desks")
}

/// Meeting room — drawn on the map, never bookable (CLAUDE.md rule 9).
model Room {
  id             String @id @default(cuid())
  organizationId String
  floorId        String
  name           String
  x              Float
  y              Float
  width          Float
  height         Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  floor        Floor        @relation(fields: [floorId], references: [id])

  @@map("rooms")
}

/// Non-desk map element (printer, kitchen, etc.) — display only.
model Utility {
  id             String  @id @default(cuid())
  organizationId String
  floorId        String
  type           String
  label          String?
  x              Float
  y              Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  floor        Floor        @relation(fields: [floorId], references: [id])

  @@map("utilities")
}

model Booking {
  id               String        @id @default(cuid())
  organizationId   String
  deskId           String
  userId           String? // null when booked for a guest (see guestName)
  guestName        String?
  bookedById       String // always set — who performed the booking (self, or admin-on-behalf)
  date             DateTime      @db.Date // site-local calendar date, weekdays only
  startAt          DateTime // UTC instant — rule 3
  endAt            DateTime // UTC instant — rule 3
  status           BookingStatus @default(CONFIRMED)
  checkedInAt      DateTime?
  cancelledAt      DateTime?
  cancelledById    String?
  recurrenceRule   Json? // Future: for repeating bookings (RFC 5545 RRULE format, optional)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  desk         Desk         @relation(fields: [deskId], references: [id])
  user         User?        @relation("BookingUser", fields: [userId], references: [id])
  bookedBy     User         @relation("BookingBookedBy", fields: [bookedById], references: [id])
  cancelledBy  User?        @relation("BookingCancelledBy", fields: [cancelledById], references: [id])

  @@map("bookings")
}

model DeskWatch {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  deskId         String
  createdAt      DateTime  @default(now())
  notifiedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  desk         Desk         @relation(fields: [deskId], references: [id])

  @@unique([userId, deskId])
  @@map("desk_watches")
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  type           String
  payload        Json
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String? // nullable: leaves room for system/background-job actions (e.g. Phase 3 auto-cancel)
  action         String
  targetType     String
  targetId       String
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User?        @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

// Phase 4 — Admin & Workplace Management Entities

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

/// Reusable "custom restriction by employee field" — one record may be
/// assigned to many desks through DeskRestrictionAssignment.
/// Example: "Editorial Only", "Credit & Equities Team".
model BookingRestriction {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// Display colour (CSS hex) used as a small visual indicator next to the name.
  color          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  rules          RestrictionRule[]
  deskAssignments DeskRestrictionAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("booking_restrictions")
}

/// Individual rule within a BookingRestriction, ordered by sortOrder.
/// Example rule 1: Department IS ANY OF [Editorial, Editorial-Forum]
///         rule 2: OR Email IS ANY OF [user@example.com]
model RestrictionRule {
  id                    String                @id @default(cuid())
  restrictionId         String
  fieldType             RestrictionFieldType
  operator              RestrictionOperator
  value                 Json // array of strings (empty for IS_EMPTY / IS_NOT_EMPTY)
  connector             RuleConnector         @default(OR)
  sortOrder             Int                   @default(0)
  createdAt             DateTime              @default(now())

  restriction BookingRestriction @relation(fields: [restrictionId], references: [id], onDelete: Cascade)

  @@index([restrictionId])
  @@map("restriction_rules")
}

/// Reusable, org-wide availability shift — a named set of weekdays such as
/// "Mon + Fri" or "Wednesday Only". Referenced by DeskRestrictionAssignment.
model AvailabilityShift {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  daysOfWeek       Int[] // 0–6 (Sun–Sat)
  startTimeMinutes Int?  // optional time-of-day window within the shift
  endTimeMinutes   Int?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization    Organization                @relation(fields: [organizationId], references: [id])
  deskAssignments DeskRestrictionAssignment[]

  @@unique([organizationId, name])
  @@map("availability_shifts")
}

/// One "restriction block" on a desk: who may book it, on which days (shift),
/// and how far ahead. Who = the mode plus its target: CUSTOM → a reusable
/// BookingRestriction, DEPARTMENT → departmentNames (matched against
/// User.department), ASSIGNED_OCCUPANTS → occupants[]. A desk holds many —
/// e.g. Mon–Wed three named people, Thu+Fri the Sales department.
/// Shifts on the same desk must not overlap on any weekday (enforced in the
/// desk router) so exactly one block applies to a given booking date.
model DeskRestrictionAssignment {
  id                       String              @id @default(cuid())
  organizationId           String
  deskId                   String
  restrictionMode          DeskRestrictionMode @default(ANYONE)
  restrictionId            String? // required when restrictionMode = CUSTOM
  /// Department names admitted when restrictionMode = DEPARTMENT (Entra-owned strings on User.department).
  departmentNames          String[]            @default([])
  shiftId                  String
  advanceBookingWindowDays Int? // null = site/system default
  sortOrder                Int                 @default(0)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id])
  desk         Desk                      @relation(fields: [deskId], references: [id], onDelete: Cascade)
  restriction  BookingRestriction?       @relation(fields: [restrictionId], references: [id], onDelete: SetNull)
  shift        AvailabilityShift         @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  occupants    DeskRestrictionOccupant[]

  @@index([organizationId])
  @@index([deskId])
  @@index([restrictionId])
  @@index([shiftId])
  @@map("desk_restriction_assignments")
}

/// The people admitted by an ASSIGNED_OCCUPANTS restriction block (up to a handful per block).
model DeskRestrictionOccupant {
  id             String   @id @default(cuid())
  organizationId String
  assignmentId   String
  userId         String
  createdAt      DateTime @default(now())

  organization Organization              @relation(fields: [organizationId], references: [id])
  assignment   DeskRestrictionAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("desk_restriction_occupants")
}

/// Desk attributes/features (e.g., standing desk, dual monitors, window seat).
model DeskAttribute {
  id             String   @id @default(cuid())
  organizationId String
  deskId         String
  type           String   // e.g., "STANDING_DESK", "DUAL_MONITORS", "WINDOW_SEAT"
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  desk         Desk         @relation(fields: [deskId], references: [id], onDelete: Cascade)

  @@unique([deskId, type])
  @@index([organizationId])
  @@index([deskId])
  @@map("desk_attributes")
}

/// Per-day operating hours for a site.
/// Example: Monday 07:00–19:00, Tuesday 07:00–19:00, etc.
model SiteOperatingHours {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String
  dayOfWeek      Int      // 0–6 (Sun–Sat)
  openAtMinutes  Int      // e.g. 420 = 07:00
  closeAtMinutes Int      // e.g. 1140 = 19:00

  organization Organization @relation(fields: [organizationId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, dayOfWeek])
  @@index([organizationId])
  @@index([siteId])
  @@map("site_operating_hours")
}

/// Logical area/group of desks on a floor (e.g. Technology, Finance, Consulting).
/// Neighbourhoods are used to visually organize desks and restrict booking by membership.
model Neighbourhood {
  id             String   @id @default(cuid())
  organizationId String
  floorId        String
  name           String
  color          String
  description    String?
  imageUrl       String?
  captain        String? // captain user ID
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  floor        Floor             @relation(fields: [floorId], references: [id], onDelete: Cascade)
  desks        NeighbourhoodDesk[]
  members      NeighbourhoodMember[]
  rules        NeighbourhoodRule[]

  @@unique([floorId, name])
  @@index([organizationId])
  @@index([floorId])
  @@map("neighbourhoods")
}

/// Link desk to neighbourhood (many-to-one).
model NeighbourhoodDesk {
  id               String   @id @default(cuid())
  neighbourhoodId  String
  deskId           String
  createdAt        DateTime @default(now())

  neighbourhood Neighbourhood @relation(fields: [neighbourhoodId], references: [id], onDelete: Cascade)
  desk          Desk          @relation(fields: [deskId], references: [id], onDelete: Cascade)

  @@unique([neighbourhoodId, deskId])
  @@index([deskId])
  @@map("neighbourhood_desks")
}

/// Employee membership in a neighbourhood (manual assignment).
model NeighbourhoodMember {
  id               String   @id @default(cuid())
  neighbourhoodId  String
  userId           String
  createdAt        DateTime @default(now())

  neighbourhood Neighbourhood @relation(fields: [neighbourhoodId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([neighbourhoodId, userId])
  @@index([userId])
  @@map("neighbourhood_members")
}

/// Rule for auto-matching neighbourhood members (e.g., "Department = Technology").
model NeighbourhoodRule {
  id               String                @id @default(cuid())
  neighbourhoodId  String
  fieldType        RestrictionFieldType
  operator         RestrictionOperator
  value            Json // array of strings (empty for IS_EMPTY / IS_NOT_EMPTY)
  connector        RuleConnector         @default(OR)
  sortOrder        Int                   @default(0)
  createdAt        DateTime              @default(now())

  neighbourhood Neighbourhood @relation(fields: [neighbourhoodId], references: [id], onDelete: Cascade)

  @@index([neighbourhoodId])
  @@map("neighbourhood_rules")
}
