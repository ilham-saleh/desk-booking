// Prisma schema for the desk booking system — multi-tenant SaaS (CLAUDE.md v2.2).
// 14 core entities. Every tenant-owned model carries an explicit organizationId,
// enforced centrally by the tenant-scoping client (src/server/db/tenant-scope.ts) —
// see CLAUDE.md architectural rule 1. The no-double-booking (rule 2) and
// one-active-booking-per-user (rule 4) constraints are GiST exclusion constraints
// added by a hand-written migration (prisma/migrations/*_booking_overlap_constraints)
// — Prisma has no schema syntax for EXCLUDE constraints, so they're invisible here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLATFORM_ADMIN
  ORG_SUPER_ADMIN
  SITE_ADMIN
  BOOKING_MANAGER
  STANDARD_USER
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum FloorPlanVersionStatus {
  DRAFT
  LIVE
  ARCHIVED
}

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  CANCELLED
  AUTO_CANCELLED
  COMPLETED
}

enum DeskState {
  AVAILABLE
  BOOKED
  SCHEDULED
  INACTIVE
}

enum RestrictionFieldType {
  DEPARTMENT
  EMAIL
  USER
}

enum RestrictionOperator {
  IS
  IS_NOT
  IS_ANY_OF
  IS_NOT_ANY_OF
}

enum DeskAssignmentMode {
  BOOKABLE
  ASSIGNED
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

/// The tenant. Every other model belongs to exactly one Organization, except
/// User — nullable there, and null only for PLATFORM_ADMIN (who belongs to no org).
model Organization {
  id     String    @id @default(cuid())
  name   String
  slug   String    @unique
  status OrgStatus @default(ACTIVE)

  ssoGoogleDomains String[]
  ssoEntraTenantId String?
  ssoEntraIssuer   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                  User[]
  permissions            Permission[]
  sites                  Site[]
  floors                 Floor[]
  floorPlanVersions      FloorPlanVersion[]
  desks                  Desk[]
  rooms                  Room[]
  utilities              Utility[]
  bookings               Booking[]
  deskWatches            DeskWatch[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  departments            Department[]
  bookingRestrictions    BookingRestriction[]
  availabilityShifts     AvailabilityShift[]
  deskAttributes         DeskAttribute[]
  siteOperatingHours     SiteOperatingHours[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  organizationId String? // null only for PLATFORM_ADMIN
  email          String
  name           String
  role           Role
  department     String?
  phone          String?
  timezone       String?
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])

  permissions              Permission[]
  bookingsAsUser           Booking[]          @relation("BookingUser")
  bookingsBookedBy         Booking[]          @relation("BookingBookedBy")
  bookingsCancelledBy      Booking[]          @relation("BookingCancelledBy")
  deskWatches              DeskWatch[]
  notifications            Notification[]
  auditLogs                AuditLog[]
  createdFloorPlanVersions FloorPlanVersion[]
  assignedDesks            Desk[]             @relation("AssignedOccupant")

  @@unique([organizationId, email])
  @@map("users")
}

model Permission {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  siteId         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id])

  @@unique([userId, siteId])
  @@map("permissions")
}

model Site {
  id             String @id @default(cuid())
  organizationId String
  name           String
  address        String?
  city           String?
  country        String?
  postalCode     String?
  description    String?
  timeZone       String

  /// Deprecated: use SiteOperatingHours instead. Kept for backwards compatibility.
  operatingHoursStart Int @default(0)
  operatingHoursEnd   Int @default(1440)

  photoUrl                    String?
  unitSystem                  UnitSystem @default(METRIC)
  allowEmployeeSeeBookings    Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id])
  floors               Floor[]
  permissions          Permission[]
  operatingHours       SiteOperatingHours[]

  @@map("sites")
}

model Floor {
  id             String @id @default(cuid())
  organizationId String
  siteId         String
  name           String
  sortOrder      Int    @default(0)

  livePlanVersionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id])
  site            Site              @relation(fields: [siteId], references: [id])
  livePlanVersion FloorPlanVersion? @relation("FloorLiveVersion", fields: [livePlanVersionId], references: [id])
  planVersions    FloorPlanVersion[] @relation("FloorVersions")
  desks           Desk[]
  rooms           Room[]
  utilities       Utility[]

  @@map("floors")
}

/// Draft/live/archived history for a floor's map background — enables the
/// draft-vs-live editor workflow (CLAUDE.md rule 8) and rollback.
model FloorPlanVersion {
  id               String                 @id @default(cuid())
  organizationId   String
  floorId          String
  status           FloorPlanVersionStatus @default(DRAFT)
  sourceFileKey    String
  renderedImageKey String?
  /// Pixel dimensions of renderedImageKey — the floor-map canvas needs these to
  /// scale the background image and position desks/rooms/utilities correctly.
  imageWidth       Int?
  imageHeight      Int?
  createdById      String
  publishedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  floor        Floor        @relation("FloorVersions", fields: [floorId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])
  liveForFloor Floor?       @relation("FloorLiveVersion")

  @@map("floor_plan_versions")
}

model Desk {
  id                String              @id @default(cuid())
  organizationId    String
  floorId           String
  number            String
  name              String?
  x                 Float
  y                 Float
  capacity          Int                 @default(1)
  isActive          Boolean             @default(true)
  requiresCheckIn   Boolean             @default(false)
  spaceType         String?
  assignmentMode    DeskAssignmentMode  @default(BOOKABLE)
  assignedOccupantId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id])
  floor              Floor               @relation(fields: [floorId], references: [id])
  assignedOccupant   User?               @relation("AssignedOccupant", fields: [assignedOccupantId], references: [id])
  bookings           Booking[]
  deskWatches        DeskWatch[]
  availabilityShifts AvailabilityShift[]
  attributes         DeskAttribute[]

  @@unique([floorId, number])
  @@map("desks")
}

/// Meeting room — drawn on the map, never bookable (CLAUDE.md rule 9).
model Room {
  id             String @id @default(cuid())
  organizationId String
  floorId        String
  name           String
  x              Float
  y              Float
  width          Float
  height         Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  floor        Floor        @relation(fields: [floorId], references: [id])

  @@map("rooms")
}

/// Non-desk map element (printer, kitchen, etc.) — display only.
model Utility {
  id             String  @id @default(cuid())
  organizationId String
  floorId        String
  type           String
  label          String?
  x              Float
  y              Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  floor        Floor        @relation(fields: [floorId], references: [id])

  @@map("utilities")
}

model Booking {
  id               String        @id @default(cuid())
  organizationId   String
  deskId           String
  userId           String? // null when booked for a guest (see guestName)
  guestName        String?
  bookedById       String // always set — who performed the booking (self, or admin-on-behalf)
  date             DateTime      @db.Date // site-local calendar date, weekdays only
  startAt          DateTime // UTC instant — rule 3
  endAt            DateTime // UTC instant — rule 3
  status           BookingStatus @default(CONFIRMED)
  checkedInAt      DateTime?
  cancelledAt      DateTime?
  cancelledById    String?
  recurrenceRule   Json? // Future: for repeating bookings (RFC 5545 RRULE format, optional)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  desk         Desk         @relation(fields: [deskId], references: [id])
  user         User?        @relation("BookingUser", fields: [userId], references: [id])
  bookedBy     User         @relation("BookingBookedBy", fields: [bookedById], references: [id])
  cancelledBy  User?        @relation("BookingCancelledBy", fields: [cancelledById], references: [id])

  @@map("bookings")
}

model DeskWatch {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  deskId         String
  createdAt      DateTime  @default(now())
  notifiedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  desk         Desk         @relation(fields: [deskId], references: [id])

  @@unique([userId, deskId])
  @@map("desk_watches")
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  type           String
  payload        Json
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String? // nullable: leaves room for system/background-job actions (e.g. Phase 3 auto-cancel)
  action         String
  targetType     String
  targetId       String
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User?        @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

// Phase 4 — Admin & Workplace Management Entities

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@map("departments")
}

/// Reusable booking restriction rules — assigned to AvailabilityShifts.
/// Example: "Editorial Only", "Credit & Equities Team", "Anyone".
model BookingRestriction {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  rules          RestrictionRule[]
  availabilityShifts AvailabilityShift[]

  @@unique([organizationId, name])
  @@map("booking_restrictions")
}

/// Individual rule within a BookingRestriction.
/// Example rule 1: Department IS ANY OF [Editorial, Editorial-Forum]
/// Example rule 2: Email IS ANY OF [user@example.com]
/// Linked by AND/OR logic stored in parent restriction (future: add logic field to rule).
model RestrictionRule {
  id                    String                @id @default(cuid())
  restrictionId         String
  fieldType             RestrictionFieldType
  operator              RestrictionOperator
  value                 Json // array of strings or single string, depending on operator
  createdAt             DateTime              @default(now())

  restriction BookingRestriction @relation(fields: [restrictionId], references: [id], onDelete: Cascade)

  @@map("restriction_rules")
}

/// Per-desk availability shift — defines when a desk is bookable and to whom.
/// Example: Desk 5.52 on Mon/Wed is "Editorial Only", Tue/Thu is "Credit & Equities", Fri is "Anyone".
model AvailabilityShift {
  id                    String   @id @default(cuid())
  organizationId        String
  deskId                String
  restrictionId         String?  // null = no restriction (anyone can book)
  name                  String?
  daysOfWeek            Int[] // 0–6 (Sun–Sat); usually [1,2,3,4,5] for weekdays
  advanceBookingWindowDays Int?  // max days in advance user can book (e.g. 30)
  startTimeMinutes      Int?     // optional per-shift start time (minutes from midnight)
  endTimeMinutes        Int?     // optional per-shift end time
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization  Organization         @relation(fields: [organizationId], references: [id])
  desk          Desk                 @relation(fields: [deskId], references: [id], onDelete: Cascade)
  restriction   BookingRestriction?  @relation(fields: [restrictionId], references: [id], onDelete: SetNull)

  @@map("availability_shifts")
}

/// Desk attributes/features (e.g., standing desk, dual monitors, window seat).
model DeskAttribute {
  id             String   @id @default(cuid())
  organizationId String
  deskId         String
  type           String   // e.g., "STANDING_DESK", "DUAL_MONITORS", "WINDOW_SEAT"
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  desk         Desk         @relation(fields: [deskId], references: [id], onDelete: Cascade)

  @@unique([deskId, type])
  @@map("desk_attributes")
}

/// Per-day operating hours for a site.
/// Example: Monday 07:00–19:00, Tuesday 07:00–19:00, etc.
model SiteOperatingHours {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String
  dayOfWeek      Int      // 0–6 (Sun–Sat)
  openAtMinutes  Int      // e.g. 420 = 07:00
  closeAtMinutes Int      // e.g. 1140 = 19:00

  organization Organization @relation(fields: [organizationId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, dayOfWeek])
  @@map("site_operating_hours")
}
