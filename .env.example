# Copy to .env and fill in real values. Never commit .env.

# --- Database (Postgres) ---
DATABASE_URL="postgresql://desk_booking:desk_booking@localhost:5432/desk_booking?schema=public"

# Separate database for the tenant-isolation test suite (npm run test) — never
# point this at your dev or prod database, tests truncate freely between runs.
DATABASE_URL_TEST="postgresql://desk_booking:desk_booking@localhost:5432/desk_booking_test?schema=public"

# --- Auth.js (NextAuth v5) ---
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Microsoft Entra ID — the only sign-in/sign-up method. Use a single-tenant
# app registration; the issuer must name your tenant, not /common/:
#   https://login.microsoftonline.com/<tenant-id>/v2.0
# `npm run db:seed` copies that tenant ID onto the dev organization so its
# employees can sign in (first sign-in creates them as Standard Users).
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Dev-only local sign-in: lets you pick any seeded user and sign in as them,
# no OAuth app registration required. Ignored whenever NODE_ENV=production,
# regardless of this value — never a usable auth path outside local dev.
AUTH_ENABLE_DEV_LOGIN="true"

# --- Realtime (LISTEN/NOTIFY -> WebSocket) ---
REALTIME_PORT="8080"
NEXT_PUBLIC_WS_URL="ws://localhost:8080"

# --- Check-in / auto-cancel ---
# Not read yet: the deadline is CHECK_IN_DEADLINE_MINUTES (60) after the booking
# starts, in src/server/booking/auto-cancel.ts.
CHECKIN_OPENS_MINUTES="120"
CHECKIN_DEADLINE_MINUTES="60"

# --- Uploads (floor-plan images, site photos) ---
UPLOAD_DIR="./uploads"

# --- Email (Amazon SES or Resend) ---
EMAIL_FROM="Desk Booking <no-reply@example.com>"
RESEND_API_KEY=""
# If using SES instead of Resend:
# AWS_REGION=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
