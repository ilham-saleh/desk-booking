# Copy to .env and fill in real values. Never commit .env.

# --- Database (Postgres) ---
DATABASE_URL="postgresql://desk_booking:desk_booking@localhost:5432/desk_booking?schema=public"

# --- Auth.js (NextAuth v5) ---
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Phase 1 seam for the future HRIS sync: while true, any SSO account not
# already present in the User table is auto-provisioned as a STANDARD_USER.
# Flip to false once HRIS sync owns user creation, so unknown sign-ins are rejected.
AUTH_ALLOW_AUTO_PROVISION="true"

# --- Realtime (LISTEN/NOTIFY -> WebSocket) ---
REALTIME_PORT="8080"
NEXT_PUBLIC_WS_URL="ws://localhost:8080"

# --- Check-in / auto-cancel (minutes before booking start) ---
CHECKIN_OPENS_MINUTES="120"
CHECKIN_DEADLINE_MINUTES="60"

# --- Uploads (floor-plan images, site photos) ---
UPLOAD_DIR="./uploads"

# --- Email (Amazon SES or Resend) ---
EMAIL_FROM="Desk Booking <no-reply@example.com>"
RESEND_API_KEY=""
# If using SES instead of Resend:
# AWS_REGION=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
